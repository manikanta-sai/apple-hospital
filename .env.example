# Base URL of your Node.js backend's API
VITE_API_BASE_URL=http://localhost:5000/api

# "true" (default) uses in-memory mock responses from src/mock/mockResponses.js
# so the widget is demoable without a backend. Set to "false" once your
# API is ready to wire in real network calls.
VITE_CHAT_MOCK_MODE=true
